{
  "ApiOptions": {
    "Name": "identity-api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "TL.Socials.Identity.Application.UseCases.UserServices.SendRequestUserRegisterEmailEventHandler": "Debug"
    }
  },
  "ConnectionStrings": {
    "IdentityPostgres": "Host=localhost;Port=5432;Database=tl-identity;Username=postgres;Password=postgres",
    "IdentityRedis": "localhost:6379"
  },
  "AllowedHosts": "*",
  "JwtTokenOptions": {
    "SecurityKey": "bXlTdXBlckF1dGhlbnRpY2F0aW9uU2VjcmV0MTIzNDU2",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "ExpiresTime": "00:30:00"
  },
  "RedisEventProcessorOptions": {
    "StreamName": "identity-event-messages",
    "ConsumerGroup": "identity-event-group",
    "ConsumerName": "identity-event-name",
    "DlqStreamName": "dead-letter-identity-event-messages"
  }
}
