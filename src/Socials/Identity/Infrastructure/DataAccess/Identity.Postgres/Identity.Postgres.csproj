<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TL.Socials.Identity.Infrastructure.DataAccess.Postgres</RootNamespace>
    <AssemblyName>TL.Socials.Identity.Infrastructure.DataAccess.Postges</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TL.Socials.Identity.Infrastructure.DependencyInjection</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0-rc.2"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0"/>
    <!-- Npgsql 10.0.0 pulls Relational 10.0.0, but EF Core 10.0.1 is compiled against 10.0.1. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.1"/>
    <!-- Transitively pulled in via Microsoft.EntityFrameworkCore.Design -> Microsoft.Build.Tasks.Core (9.0.0 with GHSA advisories). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" ExcludeAssets="all"/>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" ExcludeAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\SharedKernel\Infrastructure\SharedKernel.DataAccess.Postgres\SharedKernel.DataAccess.Postgres.csproj"/>
    <ProjectReference Include="..\..\..\Application\Identity.UseCases\Identity.UseCases.csproj"/>
    <ProjectReference Include="..\..\..\Businees\Identity.Aggregates\Identity.Aggregates.csproj"/>
  </ItemGroup>

</Project>
